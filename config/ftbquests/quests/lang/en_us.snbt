	quest.46285F64822A1FD7.quest_desc: [
		"&lACHERON RECOVERY SOLUTIONS&r"
		"&8Special Procurement Division // Contract ARS-BR-17&r"
		""
		"A private life-sciences client has requested recovery of a sealed pre-collapse archival specimen from a decommissioned secure transport."
		""
		"&7Surviving logistics records identify Transport BR-17 as the final assigned carrier. The vehicle failed to report after civil infrastructure collapse; an archived recovery survey has been reconstructed from its last verified telemetry.&r"
		""
		"&fSCOPE OF WORK&r"
		"Accept the contract to receive the &fAcheron Recovery Survey&r. Locate &fTransport BR-17&r and recover the &fSealed Biocontainment Canister&r from its interior cargo mounting."
		""
		"&7The vessel was approved for long-duration specimen storage. Surviving records state that stored cultures were rendered non-viable before transport. Legacy biological-hazard markings remain on many archival containers and do not constitute an active hazard classification.&r"
		""
		"&aCOMPENSATION:&r $2,000 upon successful delivery of recovered sample material."
		""
		"&8By accepting, the contractor acknowledges that Acheron Recovery Solutions has supplied all handling and route information available in the surviving procurement record.&r"
	]
	quest.46285F64822A1FD7.quest_subtitle: "Recover archival cargo from Transport BR-17"
	quest.46285F64822A1FD7.title: "REQUEST: Archival Specimen Recovery"

	quest.6EA6AC7A77A38A32.quest_desc: [
		"&lACHERON RECOVERY SOLUTIONS&r"
		"&8Material Processing Addendum // Contract ARS-BR-17&r"
		""
		"Transport recovery authorization confirmed. Remove the &fSealed Biocontainment Canister&r from its interior mounting and return only the preserved internal specimen; return of the storage vessel or vehicle is unnecessary."
		""
		"&7Due to prolonged environmental exposure, the locking collar may be seized. This is a common storage failure and does not alter the material classification supplied with the contract.&r"
		""
		"&fAPPROVED RECOVERY PROCEDURE&r"
		"&61.&r Place the &fSealed Biocontainment Canister&r beneath a &fMechanical Press&r to deform the outer locking collar."
		"&62.&r Remove the loosened cap from the resulting &fCompromised Biocontainment Canister&r by hand."
		"&63.&r Submit the &fExtracted Biological Sample&r for client collection."
		""
		"&7Minor venting, discoloration, particulate release, odor, or residue encountered during opening may be consistent with long-term seal deterioration. These conditions do not require cancellation of the recovery request.&r"
		""
		"&aPAYMENT ON DELIVERY:&r $2,000"
		""
		"&8Acheron Recovery Solutions assumes no responsibility for loss of sample value caused by deviation from the approved recovery procedure.&r"
	]
	quest.6EA6AC7A77A38A32.quest_subtitle: "Recover and process the BR-17 archival specimen"
	quest.6EA6AC7A77A38A32.title: "REQUEST: Sample Recovery"
	task.32FAFA1D8950264B.title: "Accept Contract"
	reward.1B70A9F6C4D23851.title: "Acheron Recovery Survey — Transport BR-17"
}
